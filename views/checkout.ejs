<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<div class="container checkout-section">
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/cart">Shopping Bag</a>
    <span>/</span>
    <span>Checkout</span>
  </div>

  <div style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 2.4rem;">Checkout & Dispatch</h1>
    <p style="color: var(--text-muted);">Please provide your shipping destination and select your payment method.</p>
  </div>

  <form action="/checkout" method="POST">
    <div style="display: grid; grid-template-columns: 1.6fr 1.2fr; gap: 3.5rem; align-items: start;">
      <!-- Left Column: Shipping Address & Payment Form -->
      <div>
        <!-- Shipping Address Card -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem; margin-bottom: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
            1. Shipping Destination
          </h3>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Full Name *</label>
              <input type="text" name="fullName" class="form-input" required value="<%= (user && user.name) ? user.name : '' %>" placeholder="e.g. Eleanor Vance">
            </div>
            <div class="form-group">
              <label class="form-label">Email Address (for tracking updates) *</label>
              <input type="email" name="email" class="form-input" required value="<%= (user && user.email) ? user.email : '' %>" placeholder="eleanor@example.com">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Contact Phone Number *</label>
            <input type="tel" name="phone" class="form-input" required value="<%= (user && user.phone) ? user.phone : '' %>" placeholder="+1 (555) 000-0000">
          </div>

          <div class="form-group">
            <label class="form-label">Street Address *</label>
            <input type="text" name="address" class="form-input" required value="<%= (user && user.address && user.address.street) ? user.address.street : '' %>" placeholder="Suite, Street, House No.">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">City *</label>
              <input type="text" name="city" class="form-input" required value="<%= (user && user.address && user.address.city) ? user.address.city : '' %>" placeholder="e.g. New York">
            </div>
            <div class="form-group">
              <label class="form-label">State / Province *</label>
              <input type="text" name="state" class="form-input" required value="<%= (user && user.address && user.address.state) ? user.address.state : '' %>" placeholder="e.g. NY">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Postal / Pincode *</label>
            <input type="text" name="pincode" class="form-input" required value="<%= (user && user.address && user.address.pincode) ? user.address.pincode : '' %>" placeholder="e.g. 10001">
          </div>
        </div>

        <!-- Payment Method Card -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
            2. Payment Method
          </h3>

          <div class="payment-methods">
            <!-- Cash on Delivery -->
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="COD" checked>
              <div>
                <strong>Cash on Delivery (COD)</strong>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                  Pay in cash upon delivery to your doorstep. Complimentary package verification.
                </p>
              </div>
            </label>

            <!-- Demo Card Payment -->
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="DEMO_CARD">
              <div>
                <strong>Demo Online Card Payment (Instant Confirmation)</strong>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                  Test instant simulated authorization (no real card details or fees charged).
                </p>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Summary -->
      <div>
        <div class="cart-order-summary" style="position: sticky; top: 100px;">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.5rem;">Bag Manifest (<%= cart.totalQty %> items)</h3>

          <div style="max-height: 280px; overflow-y: auto; margin-bottom: 1.5rem; padding-right: 0.5rem;">
            <% cart.items.forEach(function(item) { %>
              <div style="display: flex; gap: 1rem; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-light);">
                <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" style="width: 50px; height: 50px; border-radius: var(--radius-sm); object-fit: contain; background: var(--bg-secondary);">
                <div style="flex: 1;">
                  <h5 style="font-size: 0.88rem; line-height: 1.2;"><%= item.product.name %></h5>
                  <% if (item.selectedShade) { %>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Shade: <%= item.selectedShade %></div>
                  <% } %>
                  <div style="font-size: 0.78rem; color: var(--text-muted);">Qty: <%= item.quantity %> &times; $<%= item.price.toFixed(2) %></div>
                </div>
                <div style="font-weight: 700; font-size: 0.95rem;">
                  $<%= item.itemSubtotal.toFixed(2) %>
                </div>
              </div>
            <% }); %>
          </div>

          <div class="summary-row">
            <span style="color: var(--text-muted);">Subtotal</span>
            <span style="font-weight: 600;">$<%= cart.subtotal.toFixed(2) %></span>
          </div>

          <div class="summary-row">
            <span style="color: var(--text-muted);">Delivery & Packaging</span>
            <span>
              <% if (cart.shippingPrice === 0) { %>
                <strong style="color: #2E7D32;">COMPLIMENTARY</strong>
              <% } else { %>
                $<%= cart.shippingPrice.toFixed(2) %>
              <% } %>
            </span>
          </div>

          <div class="summary-row summary-total">
            <span>Total Amount</span>
            <span style="color: var(--color-burgundy); font-size: 1.4rem;">$<%= cart.totalPrice.toFixed(2) %></span>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem; padding: 1.1rem; font-size: 0.92rem;">
            CONFIRM & PLACE ORDER
          </button>
        </div>
      </div>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
