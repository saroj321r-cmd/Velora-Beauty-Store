<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<div class="container" style="padding: 4rem 1.5rem;">
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>My Account</span>
  </div>

  <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <span class="section-tag">CLIENT ACCOUNT</span>
      <h1 style="font-size: 2.4rem;">Welcome, <%= user.name %></h1>
      <p style="color: var(--text-muted);"><%= user.email %> • Member since <%= new Date(user.createdAt).getFullYear() %></p>
    </div>
    <a href="/logout" class="btn btn-outline btn-sm" style="color: #C62828;">Sign Out</a>
  </div>

  <div style="display: grid; grid-template-columns: 1.2fr 1.8fr; gap: 3rem; align-items: start;">
    <!-- Profile & Shipping Address Editor -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-sm);">
      <h3 style="font-size: 1.3rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
        Personal Details & Shipping Address
      </h3>

      <form action="/profile" method="POST">
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input type="text" name="name" class="form-input" value="<%= user.name %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Email Address (Read-only)</label>
          <input type="email" class="form-input" value="<%= user.email %>" readonly style="background: #F8F9FA; cursor: not-allowed;">
        </div>

        <div class="form-group">
          <label class="form-label">Contact Phone</label>
          <input type="tel" name="phone" class="form-input" value="<%= user.phone || '' %>" placeholder="+1 (555) 000-0000">
        </div>

        <div class="form-group">
          <label class="form-label">Street Address</label>
          <input type="text" name="street" class="form-input" value="<%= (user.address && user.address.street) || '' %>" placeholder="Suite, Street No.">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">City</label>
            <input type="text" name="city" class="form-input" value="<%= (user.address && user.address.city) || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">State</label>
            <input type="text" name="state" class="form-input" value="<%= (user.address && user.address.state) || '' %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Pincode</label>
            <input type="text" name="pincode" class="form-input" value="<%= (user.address && user.address.pincode) || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Country</label>
            <input type="text" name="country" class="form-input" value="<%= (user.address && user.address.country) || 'United States' %>">
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem;">
          SAVE DETAILS
        </button>
      </form>
    </div>

    <!-- Recent Orders & Quick Shortcuts -->
    <div>
      <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 2rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
          <h3 style="font-size: 1.3rem;">Recent Ritual Orders</h3>
          <a href="/orders" style="font-size: 0.85rem; color: var(--color-burgundy); font-weight: 600; text-decoration: underline;">View All &rarr;</a>
        </div>

        <% if (recentOrders && recentOrders.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% recentOrders.forEach(function(order) { %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
                <div>
                  <strong>#<%= order.orderNumber %></strong>
                  <div style="font-size: 0.78rem; color: var(--text-muted);"><%= new Date(order.createdAt).toLocaleDateString() %> • <%= order.items.length %> items</div>
                </div>
                <div style="text-align: right;">
                  <span class="status-tag status-<%= order.orderStatus.toLowerCase() %>"><%= order.orderStatus %></span>
                  <div style="font-weight: 700; font-size: 0.95rem; margin-top: 0.25rem;">$<%= order.totalPrice.toFixed(2) %></div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No orders placed yet.</p>
          <a href="/products" class="btn btn-outline btn-sm" style="margin-top: 1rem;">Start Shopping</a>
        <% } %>
      </div>

      <!-- Quick Links Card -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.75rem;">
        <h4 style="font-size: 1.1rem; margin-bottom: 1rem;">Quick Shortcuts</h4>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/wishlist" class="btn btn-outline btn-sm">♥ My Saved Wishlist</a>
          <a href="/cart" class="btn btn-outline btn-sm">🛍️ View Shopping Bag</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="background: #5B1E31; color: #FFF; border: none;">Admin Console</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
