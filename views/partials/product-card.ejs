<div class="product-card">
  <!-- Card Media & Badges -->
  <div class="product-card-media">
    <div class="product-badge-list">
      <% if (product.discountPrice && product.discountPercentage > 0) { %>
        <span class="badge badge-sale">-<%= product.discountPercentage %>% OFF</span>
      <% } %>
      <% if (product.bestseller) { %>
        <span class="badge badge-bestseller">BESTSELLER</span>
      <% } else if (product.newArrival) { %>
        <span class="badge badge-new">NEW</span>
      <% } %>
    </div>

    <!-- Wishlist Button -->
    <button type="button" class="wishlist-btn ajax-wishlist-toggle" data-product-id="<%= product._id %>" title="Save to Wishlist" aria-label="Save to Wishlist">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    <!-- Product Image Link -->
    <a href="/product/<%= product.slug %>">
      <img src="<%= (product.images && product.images.length > 0) ? product.images[0] : '/images/products/placeholder.svg' %>" alt="<%= product.name %>" loading="lazy">
    </a>

    <!-- Quick Add Hover Overlay -->
    <div class="product-quick-add">
      <% if (product.stock > 0) { %>
        <button type="button" class="btn btn-primary btn-sm btn-block ajax-add-to-cart" 
                data-product-id="<%= product._id %>" 
                data-shade="<%= (product.shades && product.shades.length > 0) ? product.shades[0].name : '' %>"
                data-qty="1">
          + Quick Add
        </button>
      <% } else { %>
        <button type="button" class="btn btn-outline btn-sm btn-block" disabled style="opacity: 0.6; cursor: not-allowed;">
          Sold Out
        </button>
      <% } %>
      <a href="/product/<%= product.slug %>" class="btn btn-secondary btn-sm" title="View details" aria-label="View details">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </a>
    </div>
  </div>

  <!-- Card Body -->
  <div class="product-card-body">
    <div class="product-category-tag"><%= product.subcategory || product.category %></div>
    
    <h3 class="product-title">
      <a href="/product/<%= product.slug %>"><%= product.name %></a>
    </h3>

    <!-- Shade Dots Preview -->
    <% if (product.shades && product.shades.length > 0) { %>
      <div class="shade-swatches">
        <% product.shades.slice(0, 4).forEach(function(shade) { %>
          <span class="shade-dot" style="background-color: <%= shade.hex %>;" title="<%= shade.name %>"></span>
        <% }); %>
        <% if (product.shades.length > 4) { %>
          <span class="shade-more">+<%= product.shades.length - 4 %></span>
        <% } %>
      </div>
    <% } %>

    <!-- Star Rating -->
    <div class="product-rating">
      <span class="stars">★</span>
      <span><%= (product.rating || 4.8).toFixed(1) %></span>
      <span>(<%= product.reviews || 0 %>)</span>
    </div>

    <!-- Pricing Footer -->
    <div class="product-card-footer">
      <% if (product.discountPrice && product.discountPrice < product.price) { %>
        <span class="product-price">$<%= product.discountPrice.toFixed(2) %></span>
        <span class="original-price">$<%= product.price.toFixed(2) %></span>
      <% } else { %>
        <span class="product-price">$<%= product.price.toFixed(2) %></span>
      <% } %>
    </div>
  </div>
</div>
