<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Edit Product | VELORA Admin' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-sidebar-header">
      <h2>VELORA</h2>
      <span>Executive Suite</span>
    </div>

    <ul class="admin-nav">
      <li><a href="/admin/dashboard">📊 Analytics Dashboard</a></li>
      <li class="active"><a href="/admin/products">💄 Manage Products</a></li>
      <li><a href="/admin/products/add">➕ Add New Formulation</a></li>
      <li><a href="/admin/orders">📦 Customer Orders</a></li>
      <li><a href="/admin/users">👥 Registered Clients</a></li>
      <li><a href="/" target="_blank">🌐 Live Store Preview ↗</a></li>
    </ul>

    <div class="admin-sidebar-footer">
      <a href="/logout">
        <span>🚪 Sign Out</span>
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-title">
        <h1>Edit Product: <%= product.name %></h1>
      </div>
      <a href="/admin/products" class="btn btn-outline btn-sm">&larr; Back to Products</a>
    </header>

    <div class="admin-body">
      <%- include('../partials/alerts') %>

      <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
        <div class="admin-form-grid">
          <!-- Left Column: Core Details -->
          <div class="admin-card">
            <h3 style="font-size: 1.15rem; margin-bottom: 1.25rem;">Formulation Details</h3>

            <div class="admin-input-group">
              <label>Product Name *</label>
              <input type="text" name="name" class="admin-input" required value="<%= product.name %>">
            </div>

            <div class="admin-input-group">
              <label>Editorial Description *</label>
              <textarea name="description" rows="5" class="admin-textarea" required><%= product.description %></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="admin-input-group">
                <label>Category *</label>
                <select name="category" id="adminCategorySelect" class="admin-select" required>
                  <option value="Makeup" <%= product.category === 'Makeup' ? 'selected' : '' %>>Makeup</option>
                  <option value="Skincare" <%= product.category === 'Skincare' ? 'selected' : '' %>>Skincare</option>
                </select>
              </div>

              <div class="admin-input-group">
                <label>Subcategory *</label>
                <input type="text" name="subcategory" class="admin-input" required value="<%= product.subcategory %>">
              </div>
            </div>

            <div class="admin-input-group">
              <label>Shades / Colors (Format: Name:#HEX, e.g. Bare Nude:#C48A85, Velvet Rose:#A35359)</label>
              <% 
                const shadesStr = product.shades ? product.shades.map(s => `${s.name}:${s.hex}`).join(', ') : '';
              %>
              <input type="text" name="shadesData" class="admin-input" value="<%= shadesStr %>">
            </div>

            <div class="admin-input-group">
              <label>Ingredients Archive</label>
              <textarea name="ingredients" rows="3" class="admin-textarea"><%= product.ingredients %></textarea>
            </div>

            <div class="admin-input-group">
              <label>Ritual Application (How to Use)</label>
              <textarea name="howToUse" rows="2" class="admin-textarea"><%= product.howToUse %></textarea>
            </div>
          </div>

          <!-- Right Column: Pricing, Media, Flags -->
          <div>
            <!-- Pricing & Inventory -->
            <div class="admin-card">
              <h3 style="font-size: 1.15rem; margin-bottom: 1.25rem;">Pricing & Stock</h3>

              <div class="admin-input-group">
                <label>Regular Price ($) *</label>
                <input type="number" step="0.01" name="price" class="admin-input" required value="<%= product.price %>">
              </div>

              <div class="admin-input-group">
                <label>Discounted Price ($) (Optional)</label>
                <input type="number" step="0.01" name="discountPrice" class="admin-input" value="<%= product.discountPrice || '' %>">
              </div>

              <div class="admin-input-group">
                <label>Stock Inventory *</label>
                <input type="number" name="stock" class="admin-input" required value="<%= product.stock %>">
              </div>
            </div>

            <!-- Product Media -->
            <div class="admin-card">
              <h3 style="font-size: 1.15rem; margin-bottom: 1.25rem;">Product Media</h3>
              <div style="margin-bottom: 1rem;">
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: #6C757D;">Current Image:</label>
                <img src="<%= (product.images && product.images.length > 0) ? product.images[0] : '/images/products/placeholder.svg' %>" alt="<%= product.name %>" style="width: 100px; height: 100px; object-fit: contain; background: #F8F3ED; border-radius: 6px;">
              </div>

              <div class="admin-input-group">
                <label>Replace Image (Optional)</label>
                <input type="file" name="image" id="adminImageInput" class="admin-input" accept="image/*">
              </div>
              <img id="adminImagePreview" src="" alt="Preview" style="display: none; width: 100%; height: 160px; object-fit: contain; background: #F8F3ED; border-radius: 6px; margin-top: 0.5rem;">
            </div>

            <!-- Promotional Flags -->
            <div class="admin-card">
              <h3 style="font-size: 1.15rem; margin-bottom: 1rem;">Badges & Placement</h3>

              <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; cursor: pointer;">
                <input type="checkbox" name="featured" <%= product.featured ? 'checked' : '' %>>
                <span>Feature on Homepage</span>
              </label>

              <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; cursor: pointer;">
                <input type="checkbox" name="bestseller" <%= product.bestseller ? 'checked' : '' %>>
                <span>Mark as Bestseller</span>
              </label>

              <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; cursor: pointer;">
                <input type="checkbox" name="newArrival" <%= product.newArrival ? 'checked' : '' %>>
                <span>Mark as New Arrival</span>
              </label>

              <button type="submit" class="btn btn-primary btn-block" style="background: #5B1E31; padding: 0.95rem;">
                SAVE CHANGES
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
