<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Portal | VELORA' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="background: #141110; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem;">

  <div style="background: #FFFFFF; width: 100%; max-width: 440px; border-radius: 12px; padding: 3rem 2.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-serif); font-size: 2rem; letter-spacing: 0.15em; margin-bottom: 0.25rem;">VELORA</h2>
      <span style="font-size: 0.75rem; letter-spacing: 0.25em; color: #C47C85; font-weight: 700; text-transform: uppercase;">Executive Console</span>
    </div>

    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
      <div style="background: #FDF0F0; color: #7A2424; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.85rem; margin-bottom: 1.5rem; border-left: 4px solid #B83838;">
        <%= error_msg[0] %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="admin-input-group">
        <label for="adminEmail">Administrator Email</label>
        <input type="email" name="email" id="adminEmail" class="admin-input" required placeholder="admin@velora.com" value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>

      <div class="admin-input-group">
        <label for="adminPassword">Security Key / Password</label>
        <input type="password" name="password" id="adminPassword" class="admin-input" required placeholder="••••••••••••">
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem; padding: 0.9rem; background: #5B1E31;">
        AUTHENTICATE & ENTER
      </button>
    </form>

    <div style="margin-top: 2rem; text-align: center; font-size: 0.8rem; color: #6C757D;">
      Demo Admin: <code>admin@velora.com</code> / <code>Admin@123password</code>
    </div>

    <div style="margin-top: 1rem; text-align: center;">
      <a href="/" style="font-size: 0.82rem; color: #5B1E31; text-decoration: underline;">&larr; Return to Public Store</a>
    </div>
  </div>

</body>
</html>
