<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<div class="container" style="padding: 4rem 2rem;">
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>Search Results</span>
  </div>

  <div style="margin-bottom: 3rem; text-align: center;">
    <span class="section-tag">ARCHIVE QUERY</span>
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">
      Search results for "<span style="color: var(--color-burgundy); font-style: italic;"><%= searchQuery %></span>"
    </h1>
    <p style="color: var(--text-muted);">
      Found <%= totalResults %> matching formulation<%= totalResults === 1 ? '' : 's' %>
    </p>

    <!-- Search input refill -->
    <div style="max-width: 460px; margin: 1.75rem auto 0 auto;">
      <form action="/search" method="GET" class="search-form">
        <input type="text" name="search" class="search-input" value="<%= searchQuery %>" placeholder="Refine search...">
        <button type="submit" class="search-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <% if (products && products.length > 0) { %>
    <div class="product-grid">
      <% products.forEach(function(product) { %>
        <%- include('partials/product-card', { product: product }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 6rem 1rem; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
      <h3 style="font-size: 1.6rem; margin-bottom: 0.5rem;">No Formulations Matched Your Query</h3>
      <p style="color: var(--text-muted); max-width: 450px; margin: 0 auto 2rem auto;">
        We could not find any products matching "<%= searchQuery %>". Try searching for general terms like "lipstick", "serum", "blush", or "foundation".
      </p>
      <a href="/products" class="btn btn-primary">EXPLORE ENTIRE CATALOG</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
