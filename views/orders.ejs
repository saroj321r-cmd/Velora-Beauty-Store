<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<div class="container" style="padding: 4rem 1.5rem;">
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/profile">My Account</a>
    <span>/</span>
    <span>My Orders</span>
  </div>

  <div style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 2.4rem;">Order History & Tracking</h1>
    <p style="color: var(--text-muted);">View status, tracking, and past luxury formulations ordered with VELORA.</p>
  </div>

  <% if (orders && orders.length > 0) { %>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <% orders.forEach(function(order) { %>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
          <!-- Order Header Bar -->
          <div style="background: var(--bg-primary); padding: 1.25rem 1.75rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; gap: 2.5rem; font-size: 0.85rem;">
              <div>
                <span style="color: var(--text-muted); display: block;">ORDER NUMBER</span>
                <strong>#<%= order.orderNumber %></strong>
              </div>
              <div>
                <span style="color: var(--text-muted); display: block;">DATE PLACED</span>
                <strong><%= new Date(order.createdAt).toLocaleDateString() %></strong>
              </div>
              <div>
                <span style="color: var(--text-muted); display: block;">TOTAL</span>
                <strong style="color: var(--color-burgundy);">$<%= order.totalPrice.toFixed(2) %></strong>
              </div>
            </div>

            <!-- Status Badge -->
            <div>
              <span class="status-tag status-<%= order.orderStatus.toLowerCase() %>">
                ● <%= order.orderStatus %>
              </span>
            </div>
          </div>

          <!-- Order Content Body -->
          <div style="padding: 1.75rem;">
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
              <% order.items.forEach(function(item) { %>
                <div style="display: flex; align-items: center; gap: 1.25rem;">
                  <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 60px; height: 60px; border-radius: var(--radius-sm); object-fit: contain; background: var(--bg-secondary); border: 1px solid var(--border-color);">
                  <div style="flex: 1;">
                    <h4 style="font-size: 0.95rem; margin-bottom: 0.2rem;"><%= item.name %></h4>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                      <% if (item.selectedShade) { %>Shade: <strong><%= item.selectedShade %></strong> • <% } %>
                      Quantity: <%= item.quantity %> &times; $<%= item.price.toFixed(2) %>
                    </div>
                  </div>
                  <div style="font-weight: 700; font-size: 1rem;">
                    $<%= item.subtotal.toFixed(2) %>
                  </div>
                </div>
              <% }); %>
            </div>

            <div style="border-top: 1px solid var(--border-light); padding-top: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.85rem; color: var(--text-muted);">
              <div>
                <strong>Destination:</strong> <%= order.shippingAddress.address %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %>
              </div>
              <div>
                <strong>Payment:</strong> <%= order.paymentMethod === 'COD' ? 'Cash on Delivery' : 'Demo Online Card' %> (<%= order.paymentStatus %>)
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 6rem 1rem; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">📦</div>
      <h3 style="font-size: 1.6rem; margin-bottom: 0.5rem;">No Order Records Found</h3>
      <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 2rem auto;">
        You have not placed any orders yet. Discover our signature formulations to start your first ritual.
      </p>
      <a href="/products" class="btn btn-primary">SHOP THE ARCHIVE</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
